# =============================================================================
# ArtAround — variabili per l'ambiente di SVILUPPO
# Copia in .env.dev:   cp .env.dev.example .env.dev
# Usato da:            docker compose -f docker-compose.dev.yml --env-file .env.dev ...
# =============================================================================

# --- MongoDB ---
MONGO_USER=artaround
MONGO_PASSWORD=artaround
MONGO_DB=artaround

# --- Backend ---
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=8h
SWAGGER_USER=swagger
SWAGGER_PASSWORD=swagger

# --- Frontend ---
# La API key si ottiene DOPO il primo seed:
#   docker compose -f docker-compose.dev.yml --env-file .env.dev run --rm backend npm run seed
# Copia qui la chiave stampata, poi (ri)avvia navigator e editor.
API_KEY=

# URL del backend visto dal BROWSER (Navigator gira sull'host, chiama :3002).
BACKEND_PUBLIC_URL=http://localhost:3002

# URL del backend visto dal container Editor (rete Docker interna).
EDITOR_BACKEND_URL=http://backend:3001

# Museo risolto dal Navigator via slug.
MUSEUM_SLUG=galleria-degli-uffizi
