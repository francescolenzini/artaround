@startuml ArtAround Architecture
!theme plain
skinparam linetype ortho
skinparam packageStyle rectangle

title ArtAround — architettura as-built

actor "Visitatore" as visitor
actor "Curatore" as curator

package "Navigator (React SPA)" as navigator {
  [Login e visite]
  [Player TTS/STT]
  [Mappa multi-piano]
}

package "Editor (vanilla JS)" as editor {
  [Musei e contenuti]
  [Visit builder]
  [Utenti]
}

package "App Node/Express" as app {
  [Statici Navigator]
  [Statici Editor]
  [API REST]
  [API key server-side]
  [JWT, ruoli e tenancy]
}

database "MongoDB" as mongo {
  [Dati di dominio]
  [Upload immagini]
  [Log e API key]
}

visitor --> navigator
curator --> editor
navigator --> app : HTTPS / REST
editor --> app : HTTPS / REST
app --> mongo

note bottom of app
Produzione: un container Node/Express.
Navigator: / — Editor: /editor.
end note

note bottom of mongo
Produzione: un container MongoDB
con volume persistente.
end note
@enduml
