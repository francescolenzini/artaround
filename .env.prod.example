# =============================================================================
# ArtAround — variabili per l'ambiente di PRODUZIONE
# Copia in .env.prod:  cp .env.prod.example .env.prod
# Usato da:            docker compose -f docker-compose.prod.yml --env-file .env.prod ...
#
# NON versionare .env.prod: contiene segreti reali.
# =============================================================================

# --- MongoDB ---
MONGO_USER=artaround
MONGO_PASSWORD=CAMBIA-QUESTA-PASSWORD
MONGO_DB=artaround

# --- App (Node/Express) ---
# Porta pubblicata sull'host per l'app.
APP_PORT=8080

JWT_SECRET=CAMBIA-CON-UN-SEGRETO-LUNGO-E-CASUALE
JWT_EXPIRES_IN=8h
SWAGGER_USER=swagger
SWAGGER_PASSWORD=CAMBIA-QUESTA-PASSWORD

# API key applicativa: genera una stringa casuale di almeno 32 byte esadecimali
# e usa esattamente lo stesso valore per entrambe le variabili. Il seed iniziale
# registra BOOTSTRAP_API_KEY nel DB, mentre APP_API_KEY viene iniettata
# server-side (i frontend non la espongono mai nel browser).
APP_API_KEY=CAMBIA-CON-UNA-CHIAVE-CASUALE
BOOTSTRAP_API_KEY=CAMBIA-CON-LA-STESSA-CHIAVE-CASUALE
MUSEUM_SLUG=galleria-degli-uffizi
NAVIGATOR_EDITOR_URL=/editor
