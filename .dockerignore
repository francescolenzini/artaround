# Context di build di PRODUZIONE = radice del repo artaround.
# Tieni il context piccolo: escludi tutto ciò che non serve nell'immagine finale.

**/node_modules
**/.git
**/.gitignore
**/*.log
**/.DS_Store
**/coverage
**/dist
**/.tanstack
**/.vinxi
**/.output

# Documentazione e PDF pesanti: non servono a runtime
docs

# Vecchia dockerizzazione del backend (sostituita da questo setup)
services/backend/docker

# Test del backend: non necessari nell'immagine di produzione
services/backend/tests

# Segreti / config locali
**/.env
**/.env.*
!**/.env.example
services/editor/app/serve.config.json
# Il segreto del Navigator sta in services/navigator/app/public/: il path
# precedente (services/navigator/navigator/...) non esisteva, quindi Vite lo
# copiava in dist/ e la chiave finiva in un layer dell'immagine. A runtime
# server.js lo rigenera comunque con apiKey vuota (ensureNavigatorConfig).
services/navigator/app/public/api.config.json
